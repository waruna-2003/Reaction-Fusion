{
  "version": "reactionfusion_neural_v3_development",
  "status": "development_pending_more_representative_human_labels",
  "smoothing_alpha": 1.0,
  "sentiment_classes": ["negative", "neutral", "positive", "mixed"],
  "emotion_targets": [
    "joy", "affection", "amusement", "surprise", "sadness", "anger",
    "care_empathy", "fear", "disgust", "approval", "sarcasm"
  ],
  "hidden_units": 16,
  "ensemble_seeds": [11, 29, 47, 71, 89],
  "epochs": 700,
  "learning_rate": 0.01,
  "l2": 0.015,
  "label_smoothing": 0.08,
  "emotion_loss_weight": 0.4,
  "feature_noise_std": 0.025,
  "cross_validation_folds": 5,
  "primary_fold_seed": 42,
  "stability_fold_seeds": [17, 42, 83],
  "target_coverage": 0.85,
  "minimum_abstention_threshold": 0.28,
  "maximum_abstention_threshold": 0.55,
  "temperature_candidates": [0.75, 1.0, 1.25, 1.5, 2.0, 2.5, 3.0, 4.0, 5.0],
  "training_scope": "120 uncertainty-enriched human-annotated records",
  "model_input_policy": "reaction counts and derived reaction features only; no text features"
}
